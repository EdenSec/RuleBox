{
  "platform": "shodan",
  "version": 1,
  "categories": ["运算符与匹配", "基础字段", "HTTP 指纹", "证书与 TLS", "云端与截图", "第三方痕迹", "协议指纹", "组合查询", "攻防场景"],
  "items": [
    {
      "id": "shodan-op-default",
      "title": "默认全文搜索",
      "category": "运算符与匹配",
      "code": "{{keyword}}",
      "desc": "不指定过滤器时，默认只在 banner 的 data 字段（服务返回的原始内容）中搜索关键词。",
      "tags": ["默认搜索", "data"],
      "vars": [{ "name": "keyword", "label": "关键词", "placeholder": "Apache", "example": "Apache" }],
      "source": "Shodan 官方 Query Fundamentals",
      "risk": "recon"
    },
    {
      "id": "shodan-op-all",
      "title": "全字段搜索（all）",
      "category": "运算符与匹配",
      "code": "all:\"{{keyword}}\"",
      "desc": "在所有字段（含元数据）中搜索，比默认搜索范围更广，适合只记得零散特征时兜底。",
      "tags": ["all", "全字段"],
      "vars": [{ "name": "keyword", "label": "关键词", "placeholder": "example.com", "example": "example.com" }],
      "source": "Shodan 官方 Filter Reference",
      "risk": "recon"
    },
    {
      "id": "shodan-op-and",
      "title": "空格 = AND",
      "category": "运算符与匹配",
      "code": "product:\"{{product}}\" port:{{port}}",
      "desc": "多个条件用空格分隔即逻辑与（AND），无需写 AND 关键字。",
      "tags": ["AND", "组合"],
      "vars": [
        { "name": "product", "label": "产品名称", "placeholder": "nginx", "example": "nginx" },
        { "name": "port", "label": "端口", "placeholder": "443", "example": "443" }
      ],
      "source": "Shodan 官方 Query Fundamentals",
      "risk": "recon"
    },
    {
      "id": "shodan-op-or",
      "title": "逗号 = OR",
      "category": "运算符与匹配",
      "code": "port:{{port1}},{{port2}}",
      "desc": "同一过滤器的多个值用逗号分隔即逻辑或（OR），如 port:22,3333。",
      "tags": ["OR", "多值"],
      "vars": [
        { "name": "port1", "label": "端口一", "placeholder": "22", "example": "22" },
        { "name": "port2", "label": "端口二", "placeholder": "3333", "example": "3333" }
      ],
      "source": "Shodan 官方 Search Examples",
      "risk": "recon"
    },
    {
      "id": "shodan-op-exclude",
      "title": "减号 = 排除",
      "category": "运算符与匹配",
      "code": "{{keyword}} -country:\"{{country}}\"",
      "desc": "条件前加减号 - 表示排除，可作用于过滤器或裸关键词，如 ssh -port:22。",
      "tags": ["排除", "-"],
      "vars": [
        { "name": "keyword", "label": "关键词", "placeholder": "Apache", "example": "Apache" },
        { "name": "country", "label": "排除国家代码", "placeholder": "CN", "example": "CN" }
      ],
      "source": "Shodan 官方 Query Fundamentals",
      "risk": "recon"
    },
    {
      "id": "shodan-op-quote",
      "title": "引号与空格规则",
      "category": "运算符与匹配",
      "code": "http.title:\"{{keyword}}\"",
      "desc": "过滤器名、冒号与值之间不能有空格；值包含空格或特殊字符时必须用双引号包裹，否则查询会报错。",
      "tags": ["引号", "空格"],
      "vars": [{ "name": "keyword", "label": "标题关键词", "placeholder": "管理后台", "example": "管理后台" }],
      "source": "Shodan 官方 Query Fundamentals",
      "risk": "recon"
    },
    {
      "id": "shodan-hostname",
      "title": "主机名 / 域名",
      "category": "基础字段",
      "code": "hostname:\"{{domain}}\"",
      "desc": "按主机名或域名筛选资产，多个域名可用逗号分隔：hostname:\"example.com,example.org\"。",
      "tags": ["hostname"],
      "vars": [{ "name": "domain", "label": "域名", "placeholder": "example.com", "example": "example.com" }],
      "source": "Shodan 官方 Filter Reference",
      "risk": "recon"
    },
    {
      "id": "shodan-domain",
      "title": "域名（domain）",
      "category": "基础字段",
      "code": "domain:\"{{domain}}\"",
      "desc": "匹配主机名中包含该域名的资产，与 hostname 类似，常用于子域名发现。",
      "tags": ["domain", "子域名"],
      "vars": [{ "name": "domain", "label": "域名", "placeholder": "example.com", "example": "example.com" }],
      "source": "Shodan 官方 Filter Reference",
      "risk": "recon"
    },
    {
      "id": "shodan-ip",
      "title": "指定 IP",
      "category": "基础字段",
      "code": "ip:{{ip}}",
      "desc": "查询单个 IP 的测绘结果，包含端口、协议与服务指纹。",
      "tags": ["ip"],
      "vars": [{ "name": "ip", "label": "IP 地址", "placeholder": "192.0.2.1", "example": "192.0.2.1" }],
      "source": "Shodan 官方 Filter Reference",
      "risk": "recon"
    },
    {
      "id": "shodan-port",
      "title": "指定端口",
      "category": "基础字段",
      "code": "port:{{port}}",
      "desc": "按端口筛选全球暴露服务，数字值不需要引号。",
      "tags": ["port"],
      "vars": [{ "name": "port", "label": "端口", "placeholder": "3389", "example": "3389" }],
      "source": "Shodan 官方 Filter Reference",
      "risk": "recon"
    },
    {
      "id": "shodan-port-multi",
      "title": "多个端口（逗号 OR）",
      "category": "基础字段",
      "code": "port:{{port1}},{{port2}}",
      "desc": "官方示例：ssh port:22,3333 —— 协议关键词配合多端口快速收敛目标。",
      "tags": ["port", "多值"],
      "vars": [
        { "name": "port1", "label": "端口一", "placeholder": "22", "example": "22" },
        { "name": "port2", "label": "端口二", "placeholder": "3333", "example": "3333" }
      ],
      "source": "Shodan 官方 Search Examples",
      "risk": "recon"
    },
    {
      "id": "shodan-country",
      "title": "按国家筛选",
      "category": "基础字段",
      "code": "country:\"{{country}}\"",
      "desc": "使用两位国家代码限定范围，如 CN、US、JP；多个国家逗号分隔 country:DE,CH,FR。",
      "tags": ["country"],
      "vars": [{ "name": "country", "label": "国家代码", "placeholder": "CN", "example": "CN" }],
      "source": "Shodan 官方 Filter Reference",
      "risk": "recon"
    },
    {
      "id": "shodan-city",
      "title": "按城市筛选",
      "category": "基础字段",
      "code": "city:\"{{city}}\"",
      "desc": "按城市名称筛选，配合 country 使用效果更好。",
      "tags": ["city"],
      "vars": [{ "name": "city", "label": "城市名", "placeholder": "Beijing", "example": "Beijing" }],
      "source": "Shodan 官方 Filter Reference",
      "risk": "recon"
    },
    {
      "id": "shodan-region",
      "title": "按大区/州筛选",
