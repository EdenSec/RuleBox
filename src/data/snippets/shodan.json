      "desc": "官方无 http.headers 文本过滤器，完整响应头以哈希形式提供，http.headers_hash 可匹配响应头完全一致的站点。",
      "tags": ["http.headers_hash", "指纹"],
      "vars": [{ "name": "hash", "label": "响应头哈希", "placeholder": "-1022729730", "example": "-1022729730" }],
