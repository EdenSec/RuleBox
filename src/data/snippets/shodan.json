      "code": "state:\"{{state}}\"",
      "desc": "美国州名筛选，如 Texas、New York（含空格必须双引号）。",
      "tags": ["state"],
      "vars": [{ "name": "state", "label": "州名", "placeholder": "New York", "example": "New York" }],
      "source": "Shodan 官方 Filter Reference",
      "risk": "recon"
    },
    {
      "id": "shodan-postal",
      "title": "按邮编筛选",
