{
  "platform": "fofa",
  "version": 1,
  "categories": ["运算符与匹配", "基础字段", "标记与分类", "协议与Banner", "网站内容", "证书与指纹", "归属与地理", "时间与变更", "独立IP筛选", "组合查询", "攻防场景"],
  "items": [
    {
      "id": "fofa-op-plain",
      "title": "全文关键词检索",
      "category": "运算符与匹配",
      "code": "\"{{keyword}}\"",
      "desc": "直接输入查询语句（不带字段），将从标题、html 内容、http 头信息、url 字段中搜索。",
      "tags": ["运算符", "全文检索"],
      "vars": [{ "name": "keyword", "label": "关键词", "placeholder": "后台管理", "example": "后台管理" }],
      "source": "FOFA 官方查询语法",
      "risk": "recon"
    },
    {
      "id": "fofa-op-wildcard",
      "title": "通配符模糊匹配（*=）",
      "category": "运算符与匹配",
      "code": "title*=\"{{pattern}}\"",
      "desc": "*= 为模糊匹配，值中可使用 * 或 ? 作为通配符，适合只记得部分关键词的场景。",
      "tags": ["运算符", "通配符"],
      "vars": [{ "name": "pattern", "label": "通配符表达式", "placeholder": "j?va*", "example": "j?va*" }],
      "source": "FOFA 官方查询语法",
      "risk": "recon"
    },
    {
      "id": "fofa-op-priority",
      "title": "括号优先级分组",
      "category": "运算符与匹配",
      "code": "(title=\"{{k1}}\" || title=\"{{k2}}\") && country=\"CN\"",
      "desc": "括号内容优先级最高；查询表达式有多个与或关系时，尽量在外面用（）包含起来，避免优先级歧义。",
      "tags": ["运算符", "优先级"],
      "vars": [
        { "name": "k1", "label": "关键词一", "placeholder": "管理后台", "example": "管理后台" },
        { "name": "k2", "label": "关键词二", "placeholder": "登录", "example": "登录" }
      ],
      "source": "FOFA 官方查询语法",
      "risk": "recon"
    },
    {
      "id": "fofa-op-field-null",
      "title": "查询字段不存在或为空",
      "category": "运算符与匹配",
      "code": "{{field}}=\"\"",
      "desc": "使用 =\"\" 时，可查询不存在该字段或者字段值为空的资产，常用于排查缺失标题、缺失备案的资产。",
      "tags": ["运算符", "空值"],
      "vars": [{ "name": "field", "label": "字段名", "placeholder": "title", "example": "title" }],
      "source": "FOFA 官方查询语法",
      "risk": "recon"
    },
    {
      "id": "fofa-op-field-empty",
      "title": "查询字段存在且为空",
      "category": "运算符与匹配",
      "code": "{{field}}==\"\"",
      "desc": "使用 ==\"\" 时，可查询字段存在且值为空的资产，与 =\"\"（不存在或为空）语义不同。",
      "tags": ["运算符", "空值"],
      "vars": [{ "name": "field", "label": "字段名", "placeholder": "title", "example": "title" }],
      "source": "FOFA 官方查询语法",
      "risk": "recon"
    },
    {
      "id": "fofa-op-field-notnull",
      "title": "查询字段值不为空",
      "category": "运算符与匹配",
      "code": "{{field}}!=\"\"",
      "desc": "使用 !=\"\" 时，可查询值不为空的情况，如 title!=\"\" 表示标题非空的资产。",
      "tags": ["运算符", "空值"],
      "vars": [{ "name": "field", "label": "字段名", "placeholder": "title", "example": "title" }],
      "source": "FOFA 官方查询语法",
      "risk": "recon"
    },
    {
      "id": "fofa-op-not-match",
      "title": "不匹配（!=）",
      "category": "运算符与匹配",
      "code": "{{field}}!=\"{{value}}\"",
      "desc": "!= 为不匹配，查询字段值不等于指定值的资产，常用于剔除登录页、错误页等干扰项。",
      "tags": ["运算符", "排除"],
      "vars": [
        { "name": "field", "label": "字段名", "placeholder": "title", "example": "title" },
        { "name": "value", "label": "排除值", "placeholder": "登录", "example": "登录" }
      ],
      "source": "FOFA 官方查询语法",
      "risk": "recon"
    },
    {
      "id": "fofa-op-exact-match",
      "title": "完全匹配（==）",
      "category": "运算符与匹配",
      "code": "{{field}}==\"{{value}}\"",
      "desc": "单个 = 为包含匹配；== 为完全匹配（字段整值等于指定值），用于排除仅包含该字符串的无关资产。",
      "tags": ["运算符", "精确匹配"],
      "vars": [
        { "name": "field", "label": "字段名", "placeholder": "title", "example": "title" },
        { "name": "value", "label": "匹配值", "placeholder": "后台管理", "example": "后台管理" }
      ],
      "source": "FOFA 官方查询语法",
      "risk": "recon"
    },
    {
      "id": "fofa-domain",
      "title": "根域名资产",
      "category": "基础字段",
      "code": "domain=\"{{domain}}\"",
      "desc": "查询根域名包含指定值的资产，适合从主域名快速扩展到全部子域与旁站。",
      "tags": ["domain", "资产发现"],
      "vars": [{ "name": "domain", "label": "根域名", "placeholder": "example.com", "example": "example.com" }],
      "source": "FOFA 官方字段文档",
      "risk": "recon"
    },
    {
      "id": "fofa-domain-exact",
      "title": "根域名精确匹配",
      "category": "基础字段",
      "code": "domain==\"{{domain}}\"",
      "desc": "使用 == 完全匹配根域名，排除仅包含该字符串的无关资产。",
      "tags": ["domain", "精确匹配"],
      "vars": [{ "name": "domain", "label": "根域名", "placeholder": "example.com", "example": "example.com" }],
      "source": "FOFA 官方字段文档",
      "risk": "recon"
    },
    {
      "id": "fofa-host",
