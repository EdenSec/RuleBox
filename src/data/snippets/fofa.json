      "category": "基础字段",
      "code": "host=\"{{host}}\"",
      "desc": "host 字段覆盖子域名，适合定位某一业务子域，如 oa、vpn、mail。",
      "tags": ["host", "子域名"],
      "vars": [{ "name": "host", "label": "主机名关键词", "placeholder": "oa.example.com", "example": "oa.example.com" }],
      "source": "FOFA 官方字段文档",
      "risk": "recon"
    },
    {
