{
  "platform": "daydaymap",
  "version": 1,
  "categories": ["运算符与匹配", "IP 资产", "域名", "地理与 ICP", "Web 指纹", "协议与应用", "设备指纹", "证书与 TLS", "时间组织与漏洞", "组合查询", "攻防场景"],
  "notice": "DayDayMap 官方语法为 field=\"value\" 等号形式（= 模糊 / == 精确，字段多带 ip./web./cert. 前缀），本库按官方帮助文档维护；同时兼容其他平台的 ip/port/domain/country 等部分语法。",
  "items": [
    {
      "id": "ddm-op-fuzzy",
      "title": "= 模糊匹配",
      "category": "运算符与匹配",
      "code": "web.title=\"{{keyword}}\"",
      "desc": "支持模糊匹配的语法用 = 表示模糊；不支持模糊的语法中 = 等同 ==，均为精确匹配。",
      "tags": ["=", "模糊"],
      "vars": [{ "name": "keyword", "label": "标题关键词", "placeholder": "login", "example": "login" }],
      "source": "DayDayMap 官方帮助文档",
      "risk": "recon"
    },
    {
      "id": "ddm-op-exact",
      "title": "== 精确匹配",
      "category": "运算符与匹配",
      "code": "web.title==\"{{keyword}}\"",
      "desc": "双等号表示精确匹配，避免分词带来的宽泛结果；模糊/精确以官方各语法说明为准。",
      "tags": ["==", "精确"],
      "vars": [{ "name": "keyword", "label": "标题关键词", "placeholder": "login", "example": "login" }],
      "source": "DayDayMap 官方帮助文档",
      "risk": "recon"
    },
    {
      "id": "ddm-op-and",
      "title": "&& 逻辑与",
      "category": "运算符与匹配",
      "code": "ip.port=\"{{port}}\" && protocol.service=\"{{service}}\"",
      "desc": "多个条件同时满足时用 && 连接，例：ip.port=\"21\" && protocol.service=\"ftp\"。",
      "tags": ["&&", "AND"],
      "vars": [
        { "name": "port", "label": "端口", "placeholder": "21", "example": "21" },
        { "name": "service", "label": "服务", "placeholder": "ftp", "example": "ftp" }
      ],
      "source": "DayDayMap 官方帮助文档",
      "risk": "recon"
    },
    {
      "id": "ddm-op-or",
      "title": "|| 逻辑或",
      "category": "运算符与匹配",
      "code": "ip.port=\"{{port}}\" || protocol.service=\"{{service}}\"",
      "desc": "任一条件满足即命中，官方示例：端口为 21 或服务为 FTP 的资产。",
      "tags": ["||", "OR"],
      "vars": [
        { "name": "port", "label": "端口", "placeholder": "21", "example": "21" },
        { "name": "service", "label": "服务", "placeholder": "ftp", "example": "ftp" }
      ],
      "source": "DayDayMap 官方帮助文档",
      "risk": "recon"
    },
    {
