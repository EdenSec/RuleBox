{
  "platform": "baidu",
  "version": 1,
  "categories": ["基础语法", "暴露面发现", "敏感文件", "组合技巧"],
  "notice": "百度当前高级搜索文档明确支持 site:、intitle:、inurl:、filetype:、双引号精确匹配、- 排除与 | 或关系；| 两侧建议留空格。+ 强制包含、书名号精确匹配与括号分组属于常见技巧，官方高级搜索页未单列，效果可能随检索策略变化。",
  "items": [
    {
      "id": "baidu-site",
      "title": "限定站点",
      "category": "基础语法",
      "code": "site:{{domain}} {{keyword}}",
      "desc": "把搜索范围限定在目标域名内，用于了解站点收录情况与公开内容。",
      "tags": ["site"],
      "vars": [
        { "name": "domain", "label": "域名", "placeholder": "example.com", "example": "example.com" },
        { "name": "keyword", "label": "关键词", "placeholder": "关键词", "example": "关键词" }
      ],
      "source": "百度搜索高级语法",
      "risk": "recon"
    },
    {
      "id": "baidu-intitle",
      "title": "标题限定",
      "category": "基础语法",
      "code": "intitle:\"{{keyword}}\" site:{{domain}}",
